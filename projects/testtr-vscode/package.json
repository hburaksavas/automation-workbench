{
  "name": "testtr",
  "displayName": "TestTR",
  "description": "Türkçe UI test senaryoları için VS Code desteği",
  "version": "0.1.0",
  "publisher": "testtr",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Programming Languages",
    "Testing"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p .",
    "vscode:prepublish": "npm run compile",
    "test": "npm run compile && node --test test/*.test.cjs"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "taskDefinitions": [
      {
        "type": "testtr",
        "required": [
          "action"
        ],
        "properties": {
          "action": {
            "type": "string"
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "testtr-dsl",
        "owner": "testtr",
        "source": "TestTR",
        "severity": "error",
        "fileLocation": [
          "search",
          {
            "include": [
              "${workspaceFolder}"
            ]
          }
        ],
        "pattern": {
          "regexp": "^.*?\\[ERROR\\].*? on project [^:]+: ((?:[A-Za-z]:)?[^\\r\\n:]+\\.testtr):(\\d+)(?: → .*?)? \\[DSL\\] (.+?)(?: -> \\[Help \\d+\\])?\\s*$",
          "file": 1,
          "line": 2,
          "message": 3
        }
      }
    ],
    "languages": [
      {
        "id": "testtr",
        "aliases": [
          "TestTR"
        ],
        "extensions": [
          ".testtr"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "testtr",
        "scopeName": "source.testtr",
        "path": "./syntaxes/testtr.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "testtr",
        "path": "./snippets/testtr.json"
      }
    ],
    "commands": [
      {
        "command": "testtr.validate",
        "title": "TestTR: Senaryoları doğrula"
      },
      {
        "command": "testtr.preview",
        "title": "TestTR: Üretilen Java kodunu aç"
      },
      {
        "command": "testtr.test",
        "title": "TestTR: Maven testlerini çalıştır"
      },
      {
        "command": "testtr.mcp.validate",
        "title": "TestTR: MCP ile senaryoyu doğrula"
      },
      {
        "command": "testtr.mcp.preview",
        "title": "TestTR: MCP ile Java önizlemesi"
      },
      {
        "command": "testtr.mcp.impact",
        "title": "TestTR: MCP ile değişiklik etkisini hesapla"
      },
      {
        "command": "testtr.mcp.test",
        "title": "TestTR: MCP ile etkilenen testleri çalıştır"
      },
      {
        "command": "testtr.mcp.discover",
        "title": "TestTR: Discovery ile obje keşfini başlat"
      },
      {
        "command": "testtr.mcp.suggestRegistry",
        "title": "TestTR: Discovery raporundan Registry önerisi üret"
      },
      {
        "command": "testtr.mcp.reviewRegistry",
        "title": "TestTR: Registry önerisini incele"
      },
      {
        "command": "testtr.mcp.validateRegistry",
        "title": "TestTR: Registry locator adaylarını doğrula"
      },
      {
        "command": "testtr.mcp.applyRegistry",
        "title": "TestTR: Seçilen adaylardan Registry snapshot oluştur"
      },
      {
        "command": "testtr.mcp.openResultSource",
        "title": "TestTR: MCP sonucundaki senaryoyu kaynakta aç"
      },
      {
        "command": "testtr.mcp.disconnect",
        "title": "TestTR: MCP bağlantılarını kapat"
      },
      {
        "command": "testtr.mcp.analyzeResults",
        "title": "TestTR: MCP ile JUnit hata analizini aç"
      }
    ],
    "configuration": {
      "title": "TestTR",
      "properties": {
        "testtr.profile": {
          "type": "string",
          "enum": [
            "default",
            "selenide",
            "selenium",
            "playwright"
          ],
          "default": "default",
          "description": "Maven profili. default seçili POM ayarını kullanır."
        },
        "testtr.sourceDirectory": {
          "type": "string",
          "default": "src/test/testtr",
          "description": "Test modülüne göre dosya veya dizin yolu."
        },
        "testtr.registry": {
          "type": "string",
          "default": "",
          "description": "Test modülüne göre Registry dizini veya JSON dosyası. Boşsa src/test/registry, o yoksa src/test/registry.json kullanılır."
        },
        "testtr.generatedDirectory": {
          "type": "string",
          "default": "target/generated-test-sources/testtr/dev/testtr/generated",
          "description": "Test modülüne göre dosya veya dizin yolu."
        },
        "testtr.mcp.java": {
          "type": "string",
          "default": "java",
          "description": "MCP server için Java 17+ çalıştırılabilir dosyası. Shell kullanılmaz.",
          "scope": "machine-overridable"
        },
        "testtr.mcp.testtrJar": {
          "type": "string",
          "default": "projects/testtr/mcp-server/target/testtr-mcp-server-0.1.0-SNAPSHOT.jar",
          "description": "Çalışma alanına göre TestTR MCP JAR yolu.",
          "scope": "resource"
        },
        "testtr.mcp.discoveryJar": {
          "type": "string",
          "default": "projects/testtr-discovery/target/testtr-discovery-0.1.0-SNAPSHOT.jar",
          "description": "Çalışma alanına göre Discovery JAR yolu.",
          "scope": "resource"
        },
        "testtr.mcp.mavenHome": {
          "type": "string",
          "default": "",
          "description": "Maven kurulumu (boot ve bin dizinlerinin üstü). Maven işleri için gereklidir.",
          "scope": "machine-overridable"
        },
        "testtr.mcp.pom": {
          "type": "string",
          "default": "",
          "description": "Çalışma alanına göre test modülünün pom.xml yolu. Boşsa açık dosyanın en yakın POM dosyası veya seçim kullanılır.",
          "scope": "resource"
        },
        "testtr.mcp.helpers": {
          "type": "string",
          "default": "src/test/helpers.json",
          "description": "Test modülüne göre yardımcı işlem sözleşmesi; MCP önizlemesi içindir.",
          "scope": "resource"
        },
        "testtr.mcp.requirements": {
          "type": "string",
          "default": "src/test/requirements.json",
          "description": "Test modülüne göre gereksinim kataloğu; MCP önizlemesi içindir.",
          "scope": "resource"
        },
        "testtr.mcp.impactBase": {
          "type": "string",
          "default": "HEAD",
          "description": "Değişiklik etkisi için Git temel revizyonu.",
          "scope": "resource"
        },
        "testtr.mcp.timeoutSeconds": {
          "type": "integer",
          "default": 600,
          "description": "MCP arka plan işi zaman aşımı.",
          "minimum": 1,
          "maximum": 3600,
          "scope": "resource"
        },
        "testtr.mcp.discoveryDuration": {
          "type": "integer",
          "default": 300,
          "description": "Keşif süresi (saniye). Bildirimde İptal ile erken bitirilebilir.",
          "minimum": 1,
          "maximum": 3600,
          "scope": "resource"
        },
        "testtr.mcp.browserChannel": {
          "type": "string",
          "default": "",
          "description": "Discovery tarayıcı kanalı: boşsa Playwright Chromium; chrome veya msedge kurulu tarayıcıyı kullanır.",
          "enum": [
            "",
            "chrome",
            "msedge"
          ],
          "scope": "resource"
        },
        "testtr.mcp.discoveryFlow": {
          "type": "string",
          "default": "",
          "description": "Çalışma alanına göre Discovery/locator doğrulama akış JSON dosyası (isteğe bağlı).",
          "scope": "resource"
        },
        "testtr.mcp.pageMap": {
          "type": "string",
          "default": "",
          "description": "Çalışma alanına göre URL → Registry sayfa adı eşleme JSON dosyası.",
          "scope": "resource"
        },
        "testtr.mcp.baseUrl": {
          "type": "string",
          "default": "",
          "description": "Göreli Registry adreslerini çözmek için temel URL.",
          "scope": "resource"
        },
        "testtr.mcp.reportsDirectory": {
          "type": "string",
          "default": "",
          "description": "Test modülüne göre özel Surefire rapor dizini; boşsa target/surefire-reports.",
          "scope": "resource"
        }
      }
    }
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/vscode": "1.95.0",
    "typescript": "5.8.3"
  }
}
